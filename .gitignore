# ============================================================
# GRIDGO Monorepo .gitignore
# ============================================================

# === OS ===
.DS_Store
Thumbs.db
*.swp

# Flutter platform stubs generated at repo root (belong inside apps/mobile/)
/linux/
/macos/
/windows/

# === IDE ===
.idea/
.vscode/
*.iml
*.ipr
*.iws

# === Flutter / Dart (apps/mobile/) ===
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/
.fvm/

# Android build artifacts
**/android/app/debug
**/android/app/profile
**/android/app/release
**/android/.gradle
**/android/local.properties

# iOS build artifacts
**/ios/Pods/
**/ios/.symlinks/

# === NestJS / Node.js (server/) ===
node_modules/
dist/
.env
.env.local
.env.*.local
*.js.map

# === Secrets / Credentials ===
*.jks
*.keystore
*.p12
*.pem
firebase-service-account.json
*-firebase-adminsdk-*.json
google-services.json
GoogleService-Info.plist

# === Project specific ===
screenshots-for-agents/
.worktrees/
.superpowers/
debug-output.txt
debug-page.js
riders_debug.png
compile_errors*.txt
error.txt
out.txt
status.txt

# === Vite dev cache ===
**/.vite/

# === Misc ===
*.class
*.log
*.pyc
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
app.*.symbols
app.*.map.json
