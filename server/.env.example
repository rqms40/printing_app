# ============================================================
# GRID Server — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Database (PostgreSQL) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=grid_print
DATABASE_USER=postgres
DATABASE_PASSWORD=your_db_password_here

# --- Authentication (JWT) ---
# IMPORTANT: Change this to a strong random secret in production!
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRATION=7d

# --- Server ---
PORT=3000
NODE_ENV=development

# --- PayMongo (Philippine Payment Gateway) ---
# Sign up: https://dashboard.paymongo.com
# PAYMONGO_SECRET_KEY=sk_test_xxx
# PAYMONGO_PUBLIC_KEY=pk_test_xxx
# PAYMONGO_WEBHOOK_SECRET=whsec_xxx

# --- File Storage (MinIO — local dev; swap endpoint/keys for S3/R2 in production) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=grid-print
MINIO_USE_SSL=false
# Public URL used to rewrite presigned URLs for browser access (set to the externally accessible MinIO address)
# MINIO_PUBLIC_URL=http://192.168.1.x:9000

# --- Firebase Cloud Messaging (Push Notifications) ---
# FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# --- OSRM (Route Directions — free, no key needed) ---
OSRM_BASE_URL=https://router.project-osrm.org
