# ============================================================
# GRIDGO Server — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Database (PostgreSQL) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=grid_print
DATABASE_USER=postgres
DATABASE_PASSWORD=your_db_password_here

# --- Authentication (JWT) ---
# IMPORTANT: Change this to a strong random secret in production!
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRATION=7d

# --- Server ---
PORT=3000
NODE_ENV=development

# --- PayMongo (Philippine Payment Gateway) ---
# Sign up: https://dashboard.paymongo.com
# PAYMONGO_SECRET_KEY=sk_test_xxx
# PAYMONGO_PUBLIC_KEY=pk_test_xxx
# PAYMONGO_WEBHOOK_SECRET=whsec_xxx

# --- File Storage (MinIO — local dev; swap endpoint/keys for S3/R2 in production) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=grid-print
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
# Public URL used to rewrite presigned URLs for browser access (set to the externally accessible MinIO address)
MINIO_PUBLIC_URL=

# Browser-reachable host used by the integrated LAN development stack.
GRIDGO_PUBLIC_HOST=192.168.40.201

# Trust this many reverse-proxy hops when resolving req.ip. Keep 0 for direct
# deployments; isolated E2E stacks may set 1 and provide actor-specific XFF.
GRIDGO_TRUST_PROXY_HOPS=0

# --- Firebase Cloud Messaging (Push Notifications) ---
# FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# --- Owned OSRM-compatible road routing service ---
# Production must point to an owned or supported endpoint. The public OSRM
# demo is intentionally not a runtime fallback.
ROUTING_BASE_URL=http://localhost:5000
ROUTING_PROFILE=driving
ROUTING_TIMEOUT_MS=5000
GRIDGO_STORE_LATITUDE=7.064
GRIDGO_STORE_LONGITUDE=125.6079

# OpenRouter AI (GridBot)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FALLBACK_MODEL=openai/gpt-3.5-turbo

# --- Email (Gmail SMTP for support ticket replies) ---
# Use a Gmail App Password (Google Account → Security → App passwords).
EMAIL_USER=your-address@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
